# host-config.json, which holds the engine's pipe encryption key.
native/engine/
host-config.json
# Setup's temp folder, and a Zalo installer kept with --keep-download.
native/.setup-tmp/
ZaloSetup*.exe
*.7z
*.asar
# Edge registration files. They contain this PC's paths (the project folder and
# node.exe), so setup generates them on each machine.
native/host/com.zalo_web_call.host.json
native/host/zalo-call-host.cmd

# --- Logs: call activity, device IDs, crash dumps ------------------------------
native/logs/
*.log
*.dmp

